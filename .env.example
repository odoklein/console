# ---- the Console itself ----
# Its own Postgres (never an agency database). Local without Docker: `npm run db:local`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/postgres
# 1 for the embedded local database (single session), 10 on a real Postgres.
DB_POOL_MAX=1
PORT=3100
CONSOLE_URL=http://localhost:3100
# openssl rand -hex 32. Encrypts agency secrets at rest: losing it = losing access to every agency's secrets.
CONSOLE_ENCRYPTION_KEY=
LOG_LEVEL=info

# ---- where agencies are created (same names as the CRM's provision.infra.env) ----
PROVISION_PLATFORM_DOMAIN=crm-agence.fr
PROVISION_PG_ADMIN_URL=postgresql://postgres:ADMIN_PASSWORD@pg:5432/postgres
# PROVISION_PG_APP_HOST=pg
# PROVISION_PG_PARAMS=sslmode=require
PROVISION_MINIO_ENDPOINT=https://minio.example.com
PROVISION_MINIO_ACCESS_KEY_ID=ADMIN_ACCESS_KEY
PROVISION_MINIO_SECRET_ACCESS_KEY=ADMIN_SECRET_KEY
# With an alias, each agency gets a key limited to its own bucket (mc is in the image).
PROVISION_MINIO_MC_ALIAS=platform
PROVISION_DOKPLOY_URL=https://dokploy.example.com
PROVISION_DOKPLOY_API_KEY=DOKPLOY_API_KEY
# PROVISION_DOKPLOY_PROJECT=agencies
# PROVISION_IMAGE_REPO=ghcr.io/odoklein/captainprospect-crm
# Release tag new agencies start on (never :main).
PROVISION_DEFAULT_TAG=v2026.11.1
PROVISION_REGISTRY_USER=github-username
PROVISION_REGISTRY_TOKEN=ghp_read_packages_token
# Docker network the migrate container joins to reach Postgres.
PROVISION_DOCKER_NETWORK=dokploy-network
# Public proxy's watched directory (mounted into this container).
PROVISION_PROXY_DYNAMIC_DIR=/data/coolify/proxy/dynamic
# KEY=VALUE file copied into every agency (mounted into this container).
PROVISION_SHARED_ENV=/run/console/shared.env

# ---- backups ----
BACKUP_BUCKET=console-backups
# Another S3 endpoint (another region) keeps backups off the server. Empty = the MinIO above.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=
# Off-site copy of every encrypted backup and export (Backblaze B2, EU region). The bucket must exist;
# the application key can be limited to it. Empty = no off-site copy (the Plateforme page says so).
# OFFSITE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# OFFSITE_S3_REGION=eu-central-003
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=2
RESTORE_DRILL_DAY=1

# ---- alerts and invite emails ----
ALERT_EMAIL_TO=ops@example.com
# ALERT_SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HEALTH_FAILURES_BEFORE_ALERT=3
# Calls every agency's /api/instance/cron on schedule. Turn off only if crons are set per deployment.
CENTRAL_CRON=true
